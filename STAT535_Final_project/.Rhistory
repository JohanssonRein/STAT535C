j = test_id,
x = cross_cov,
dims = c(n, n_test)
)
#-------------------------------------------------------------------------
# Predict at a new location y
# Regression prediction on testing set
Y_reg_pred <- as.vector(
X_test %*% beta_ols
)
# Spatial residuals from training observations
r_train <- Y - as.vector(X %*% beta_ols)
# Solve V_train * a = r_train
a <- as.vector(
solve(V_chol, r_train)
)
# Predict the spatial effect at testing locations
w_pred <- as.vector(
crossprod(C_cross, a)
)
# FINAL PREDICTION
Y_pred <- Y_reg_pred + w_pred
#-----------------------------------------------------------------------
# Basic disgnostics
prediction_results <- data.frame(
x = sim_test$x,
y = sim_test$y,
Observed = Y_test,
Predicted = Y_pred,
Residual = Y_test - Y_pred
)
head(prediction_results)
MSE <- mean((Y_test - Y_pred)^2)
RMSE <- sqrt(MSE)
MAE <- mean(abs(Y_test - Y_pred))
cat("Test MSE:", MSE, "\n")
cat("Test RMSE:", RMSE, "\n")
cat("Test MAE:", MAE, "\n")
#----------------------------------------------------------------------
# Prediction variance
var_pred <- numeric(n_test)
batch_size <- 100
for (start in seq(1, n_test, by = batch_size)) {
idx <- start:min(start + batch_size - 1, n_test)
C_batch <- as.matrix(
C_cross[, idx, drop = FALSE]
)
A <- as.matrix(
solve(V_chol, C_batch)
)
reduction <- colSums(C_batch * A)
# Predictive variance for a new noisy observation Y(s)
var_pred[idx] <- sigma2_hat + tau2_hat - reduction
}
# Numerical safety
var_pred <- pmax(var_pred, 0)
sd_pred <- sqrt(var_pred)
#------------------------------------------------------------------------
prediction_results <- data.frame(
x = sim_test$x,
y = sim_test$y,
Observed = Y_test,
Predicted = Y_pred,
Residual = Y_test - Y_pred,
Pred_SD = sd_pred
)
#-----------------------------------------------------------------------
# Plotting
zlim <- range(
c(prediction_results$Observed,
prediction_results$Predicted),
na.rm = TRUE
)
# Symmetric range for residual map
res_lim <- max(abs(prediction_results$Residual), na.rm = TRUE)
# Observed plot
p_obs <- ggplot(
prediction_results,
aes(x = x, y = y, color = Observed)
) +
geom_point(shape = 15, size = 2) +
coord_equal() +
scale_color_viridis_c(
option = "viridis",
limits = zlim
) +
labs(
title = "Observed Surface (Test Set)",
x = "X coordinate",
y = "Y coordinate",
color = "Observed Y"
) +
theme_minimal(base_size = 14)
# Predicted plot
p_pred <- ggplot(
prediction_results,
aes(x = x, y = y, color = Predicted)
) +
geom_point(shape = 15, size = 2) +
coord_equal() +
scale_color_viridis_c(
option = "viridis",
limits = zlim
) +
labs(
title = "Predicted Surface",
x = "X coordinate",
y = "Y coordinate",
color = "Predicted Y"
) +
theme_minimal(base_size = 14)
p_pred
# Residual map
p_resid <- ggplot(
prediction_results,
aes(x = x, y = y, color = Residual)
) +
geom_point(shape = 15, size = 2) +
coord_equal() +
scale_color_gradient2(
low = "blue",
mid = "white",
high = "red",
midpoint = 0,
limits = c(-res_lim, res_lim)
) +
labs(
title = "Residual Map",
x = "X coordinate",
y = "Y coordinate",
color = "Y - Pred"
) +
theme_minimal(base_size = 14)
p_resid
# Predictive SD
p_sd <- ggplot(
prediction_results,
aes(x = x, y = y, color = Pred_SD)
) +
geom_point(shape = 15, size = 2) +
coord_equal() +
scale_color_viridis_c(option = "magma") +
labs(
title = "Predictive SD Map",
x = "X coordinate",
y = "Y coordinate",
color = "Pred SD"
) +
theme_minimal(base_size = 14)
p_sd
# Plotting the prediction results.
library(readr)
library(dplyr)
library(ggplot2)
library(geoR)
library(MASS)
library(rjags)
library(coda)
library(fields)
library(spdep)
##Part I: Loading data and data cleaning
#Read the data， the data is also available on my Github: https://github.com/JohanssonRein/STAT535C/blob/main/rentfaster.csv
rental <- read_csv("rentfaster.csv")
#By running nrow(rental) and ncol(rental),
#the data has 25771 rows (observations) and 18 columns (covariates)
#We restrict to observations in Alberta. This creates 13777 observations
rental_AB <- rental %>%
filter(province == "Alberta", city == "Calgary")
# Data cleaning processes:
rent_AB <- rental_AB %>%
# This makes sure to assign 0 bedrooms to a studio apartment, as well as make the
# number of bedrooms, as well as square feet numeric, by using parse_number function
mutate(
beds = case_when(
grepl("studio", beds, ignore.case = TRUE) ~ 0,
TRUE ~ parse_number(beds)
),
#Here we decode whether pets are allowed as a binary variable
cats_allowed = as.integer(cats),
dogs_allowed = as.integer(dogs),
pets_allowed = as.integer(cats | dogs),
sq_feet = parse_number(sq_feet),
#We divide the property into the following main types:
property_type = case_when(
type %in% c("Apartment","Condo Unit") ~ "Apartment",
type %in% c("House","Townhouse") ~ "House",
type == "Basement" ~ "Basement",
type == "Room For Rent" ~ "Room For Rent",
TRUE ~ "Others"
),
property_type = factor(
property_type,
levels = c(
"Apartment",
"Basement",
"House",
"Room For Rent",
"Others"
)
)
) %>%
# We would like to remove some extreme observations, or bad data points.
# Especially, we restrict our attention to the Calgary-Edmonton area to avoid extremely little observations across remote places, since Calgary-Edmonton area itself takes up to 10510 observations.
filter(
!is.na(price),
price > 200,
price < 10000,
!is.na(sq_feet),
!is.na(longitude),
!is.na(latitude),
sq_feet > 250,
beds <= 6,
!type %in% c("Office Space", "Parking Spot", "Storage"),
is.finite(latitude),
is.finite(longitude),
longitude >= -114.5,
longitude <= -113.0,
latitude >= 50.8,
latitude <= 53.8
)
#Finally, the cleaned data has 10510 observations (Calgary-Edmonton area)
#Since prices are positive, we work with log-price
rent_AB <- rent_AB %>% mutate(log_price = log(price))
## Part 2 Regression model
#We first fit a baseline regression model where we do not consider any spatial dependency.
# The covariates we consider are the number of bedrooms, number of bathrooms, is pets allowed (Binary) and the property type (5 main types)
# for later purposes, we randomly select 80% of our data into a training set and the remaining as the testing set.
# Using our 80-20 training/testing split, we have 8408 observations.
set.seed(123)
train <- sample(
seq_len(nrow(rent_AB)),
size = floor(0.8 * nrow(rent_AB))
)
rent_AB_train <- rent_AB[train, ]
rent_AB_test  <- rent_AB[-train, ]
rent_AB_lm <- lm(
log_price ~ beds + baths + pets_allowed + property_type,
data = rent_AB_train,
na.action = na.exclude
)
summary(rent_AB)
summary(rent_AB_train)
summary(rent_AB_lm)
fitted_log_price <- predict(rent_AB_lm, newdata = rent_AB_train)
residuals <- rent_AB_train$log_price - fitted_log_price
# Plotting fitted log-price versus actual log-price
plot(
fitted_log_price, rent_AB_train$log_price,
xlab = "Fitted log-price",
ylab = "Actual log-price",
main = "Fitted v.s actual log price on training set",
pch = 16,
cex = 0.6
)
abline(0, 1, col = "red", lwd = 2)
# Plotting fitted log-price versus the residuals on the training set
plot(
fitted_log_price, residuals,
xlab = "Fitted log-price",
ylab = "Residuals",
main = "",
pch = 16,
cex = 0.6
)
abline(h=0, col = "red", lwd = 2)
## Part III: Modeling spatial dependency
resid1 <- residuals(rent_AB_lm)
lm_trend <- lm(
resid1 ~ longitude + latitude +
I(longitude^2) + I(latitude^2) + I(longitude * latitude),
data = rent_AB_train
)
summary(lm_trend)
#Since multiple listings may have the exact spatial coordinate (coming from the same unit),
# we add a random noise to those duplicates so the spatial coordinates are unique.
rent_AB_train$resid1 <- residuals(rent_AB_lm)
rent_spatial <- rent_AB_train %>%
mutate(
resid_spatial = resid1
) %>%
filter(
is.finite(longitude),
is.finite(latitude),
is.finite(resid_spatial)
) %>%
group_by(longitude, latitude) %>%
mutate(
n_at_site = n(),
duplicate_site = n_at_site > 1
) %>%
ungroup() %>%
mutate(
lon_jitter = longitude,
lat_jitter = latitude
)
# Add random noise only to duplicate sites, so we have 8408 observations with unique spatial coordinates
set.seed(123)
idx <- which(rent_spatial$duplicate_site)
rent_spatial$lon_jitter[idx] <-
rent_spatial$longitude[idx] +
runif(length(idx), -1e-6, 1e-6)
rent_spatial$lat_jitter[idx] <-
rent_spatial$latitude[idx] +
runif(length(idx), -1e-6, 1e-6)
#Using GeoR package to get some illustrations of our data
AB_geo <- as.geodata(
rent_spatial,
coords.col = c("lon_jitter", "lat_jitter"),
data.col = "resid_spatial"
)
summary(AB_geo)
plot(AB_geo)
# variogram
#vario_cloud <- variog(AB_geo, option = "cloud")
#plot(vario_cloud)
vario <- variog(AB_geo, uvec = seq(0, 0.2, by = 0.01))
plot(vario)
library(readr)
library(dplyr)
library(ggplot2)
library(geoR)
library(MASS)
library(rjags)
library(coda)
library(fields)
library(spdep)
library(stringr)
##Part I: Loading data and data cleaning
#Read the data， the data is also available on my Github: https://github.com/JohanssonRein/STAT535C/blob/main/rentfaster.csv
rental <- read_csv("rentfaster.csv")
#By running nrow(rental) and ncol(rental),
#the data has 25771 rows (observations) and 18 columns (covariates)
#We restrict to observations in Calgary, Alberta. This creates 9836 observations
rental_AB <- rental %>%
filter(province == "Alberta", city == "Calgary")
# Data cleaning processes:
rent_AB <- rental_AB %>%
# This makes sure to assign 0 bedrooms to a studio apartment, as well as make the
# number of bedrooms, as well as square feet numeric, by using parse_number function
mutate(
beds = if_else(
grepl("Studio|none", beds, ignore.case = TRUE),
"0",
as.character(beds)
),
beds = parse_number(beds),
#Here we decode whether pets are allowed as a binary variable
cats_allowed = as.integer(cats),
dogs_allowed = as.integer(dogs),
pets_allowed = as.integer(cats | dogs),
sq_feet = as.numeric(
stringr::str_extract(
gsub(",","", as.character(sq_feet)),
"[0-9]+\\.?[0-9]*"
)
),
#We divide the property into the following main types:
property_type = case_when(
type %in% c("Apartment","Condo Unit") ~ "Apartment",
type %in% c("House","Townhouse") ~ "House",
type == "Basement" ~ "Basement",
type == "Room For Rent" ~ "Room For Rent",
TRUE ~ "Others"
),
property_type = factor(
property_type,
levels = c(
"Apartment",
"Basement",
"House",
"Room For Rent",
"Others"
)
)
) %>%
# We would like to remove some extreme observations, or bad data points.
# Especially, we restrict our attention to the Calgary-Edmonton area to avoid extremely little observations across remote places, since Calgary-Edmonton area itself takes up to 10510 observations.
filter(
!is.na(price),
price > 200,
price < 10000,
beds <= 6,
!type %in% c("Office Space", "Parking Spot", "Storage"),
is.finite(latitude),
is.finite(longitude),
longitude >= -114.5,
longitude <= -113.0,
latitude >= 50.8,
latitude <= 53.8
)
#Finally, the cleaned data has 9657 observations (Calgary, AB)
#Since prices are positive, we work with log-price (maybe it is worth to examine using price instead of log-price)
rent_AB <- rent_AB %>% mutate(log_price = log(price))
## Part 2 Regression model
#We first fit a baseline regression model where we do not consider any spatial dependency.
# The covariates we consider are the number of bedrooms, number of bathrooms, is pets allowed (Binary) and the property type (5 main types)
# for later purposes, we randomly select 80% of our data into a training set and the remaining as the testing set.
# Using our 80-20 training/testing split, we have 8408 observations.
set.seed(123)
train <- sample(
seq_len(nrow(rent_AB)),
size = floor(0.8 * nrow(rent_AB))
)
rent_AB_train <- rent_AB[train, ] # Training set has 7725 observations
rent_AB_test  <- rent_AB[-train, ] # Testing set has 1932 observations
rent_AB_lm <- lm(
log_price ~ beds + baths + pets_allowed + property_type,
data = rent_AB_train,
na.action = na.exclude
)
summary(rent_AB)
summary(rent_AB_train)
summary(rent_AB_lm)
# Residuals
rent_AB_train <- rent_AB_train %>%
mutate(
fitted_log_price = as.numeric(
predict(rent_AB_lm, newdata = rent_AB_train)
),
resid_lm = log_price - fitted_log_price
)
# Test-set predictions from the baseline regression
rent_AB_test <- rent_AB_test %>%
mutate(
predicted_log_price = as.numeric(
predict(rent_AB_lm, newdata = rent_AB_test)
),
predicted_residual = log_price - predicted_log_price
)
fitted_log_price <- predict(rent_AB_lm, newdata = rent_AB_train)
residuals <- rent_AB_train$log_price - fitted_log_price
# Plotting fitted log-price versus actual log-price
plot(
fitted_log_price, rent_AB_train$log_price,
xlab = "Fitted log-price",
ylab = "Actual log-price",
main = "Fitted v.s actual log price on training set",
pch = 16,
cex = 0.6
)
abline(0, 1, col = "red", lwd = 2)
# Plotting fitted log-price versus the residuals on the training set
plot(
fitted_log_price, residuals,
xlab = "Fitted log-price",
ylab = "Residuals",
main = "",
pch = 16,
cex = 0.6
)
abline(h=0, col = "red", lwd = 2)
# Run our model for the testing set and check residuals
predicted_log_price <- predict(rent_AB_lm, newdata = rent_AB_test)
predicted_residual <- rent_AB_test$log_price - predicted_log_price
plot(
predicted_log_price, rent_AB_test$log_price,
xlab = "Predicted log price",
ylab = "Actual log-price",
main = "",
pch = 16,
cex = 0.6
)
abline(0, 1, col = "red", lwd=2)
plot(
predicted_log_price, predicted_residual,
xlab = "Precidted log-price",
ylab = "Residuals on testing set",
main = "",
pch = 16,
cex = 0.6
)
abline(h=0, col = "red", lwd = 2)
# We want to see if our linear model works well when spatial dependency is removed.
#nrow(rent_AB) = 9657
# We start by grouping the observations with the same spatial location (they are likely from the same apartment building)
rent_AB_uni <- rent_AB_train %>%
filter(
is.finite(longitude),
is.finite(latitude),
is.finite(resid_lm)
) %>%
group_by(longitude, latitude) %>%
summarise(
n_site = n(),
mean_residual = mean(resid_lm),
.groups = "drop"
)
cat(
"Training observations with valid residuals:",
sum(is.finite(rent_AB_train$resid_lm)), # 7721 training observations with valid residual
"\n"
)
cat(
"Unique training locations:",
nrow(rent_AB_uni), #3125 Unique training locations
"\n"
)
#Create GeoR data type
geo_cal <- geoR::as.geodata(
rent_AB_uni,
coords.col = c("longitude", "latitude"),
data.col = "mean_residual"
)
summary(geo_cal)
vario_cal <- variog(
geo_cal,
uvec = seq(0,0.2, by = 0.01),
estimator.type = "classical"
)
plot(vario_cal)
vario <- variog(geo_cal, uvec = seq(0, 0.15, by = 0.01))
plot(vario)
